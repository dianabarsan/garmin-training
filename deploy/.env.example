# Copy to deploy/.env and edit.

# The public hostname for the server; create an A/AAAA DNS record for it that
# points at this machine before starting.
MCP_DOMAIN=garmin.example.com

# Optional overrides
# ADMIN_PORT=8808     # loopback-only port used to replace the Garmin key
# HTTP_PORT=80
# HTTPS_PORT=443
